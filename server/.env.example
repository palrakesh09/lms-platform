NODE_ENV=development
PORT=5000

# Local example: mongodb://127.0.0.1:27017/lms-platform
# Atlas: paste your connection string in your real .env (never here)
MONGODB_URI=mongodb://127.0.0.1:27017/lms-platform

# Allowed browser origin(s) for CORS and CSRF origin checks. Comma-separate multiple origins.
# Exact match, no trailing slash: http://localhost:5173 is not the same origin as http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173

# Signing key for auth tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value in every environment. Never commit the real value.
JWT_SECRET=

# Token and cookie lifetime: a number plus s, m, h or d (e.g. 30m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Optional: lax (default), strict, or none. "none" is only for cross-site production
# deployments and requires NODE_ENV=production (HTTPS).
COOKIE_SAME_SITE=lax

# One-time bootstrap of the first administrator. Used only by `npm run create-admin`.
# Put real values in your local .env, run the script, then delete SEED_ADMIN_PASSWORD from it.
# SEED_ADMIN_NAME=Rakesh Pal
# SEED_ADMIN_EMAIL=palrakesh394327@gmail.com
# SEED_ADMIN_PASSWORD=palrakesh743596

# Storage provider: local (default, for development) or s3 (S3-compatible: AWS S3, R2, MinIO, ...)
STORAGE_PROVIDER=local

# Local provider: absolute or relative path, outside any publicly served directory (there is none in
# this app, but keep it that way). Never expose this directory via express.static or similar.
STORAGE_LOCAL_DIRECTORY=./uploads

# S3 provider (required only when STORAGE_PROVIDER=s3). STORAGE_ENDPOINT is only needed for
# S3-compatible services that are not AWS itself (R2, MinIO, etc.) — leave blank for real AWS S3.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Signs local-storage download links. Generate the same way as JWT_SECRET. If left blank, JWT_SECRET
# is reused (fine for development; use a distinct value in production).
MEDIA_SIGNING_SECRET=

# Per-category upload ceilings, enforced server-side regardless of any frontend check.
MEDIA_MAX_IMAGE_SIZE_MB=5
MEDIA_MAX_DOCUMENT_SIZE_MB=20

# AI assistant (Claude). Disabled by default — no key is required unless you turn this on.
AI_ENABLED=false

# Required only when AI_ENABLED=true. Never commit a real key.
ANTHROPIC_API_KEY=
# A current Anthropic model identifier (check Anthropic's docs for the latest). Required when AI_ENABLED=true.
ANTHROPIC_MODEL=

# All of these have safe defaults; only set them to override.
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_MESSAGE_LENGTH=4000
AI_MAX_CONTEXT_CHARS=6000
AI_MAX_HISTORY_MESSAGES=10
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_LIMIT_PER_USER=50