NODE_ENV=development
PORT=5000

# Local example: mongodb://127.0.0.1:27017/lms-platform
# Atlas: paste your connection string in your real .env (never here)
MONGODB_URI=

# Allowed browser origin(s) for CORS and CSRF origin checks. Comma-separate multiple origins.
# Exact match, no trailing slash: http://localhost:5173 is not the same origin as http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173

# Signing key for auth tokens, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a different value in every environment. Never commit the real value.
JWT_SECRET=

# Token and cookie lifetime: a number plus s, m, h or d (e.g. 30m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Optional: lax (default), strict, or none. "none" is only for cross-site production
# deployments and requires NODE_ENV=production (HTTPS).
COOKIE_SAME_SITE=lax